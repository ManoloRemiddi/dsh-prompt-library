{
  "name": "dsh-prompt-library",
  "version": "0.2.1",
  "description": "Local prompt library editor for DeepSeek Harness, with standalone SQLite storage or an existing Augmentor service",
  "license": "MIT",
  "author": "Manolo Remiddi",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "services",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "react-dom": "^18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManoloRemiddi/dsh-prompt-library.git"
  },
  "bugs": {
    "url": "https://github.com/ManoloRemiddi/dsh-prompt-library/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "prompt-library"
  ]
}
